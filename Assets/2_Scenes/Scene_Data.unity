MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 612921059}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8bca741924f22af48b8bbb8477cdc1e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialougeData:
    dialogueSet:
    - questID: 1
      dialogueID: 4
      speakerName: "\uBAA8\uD5D8\uAC00 \uB9C8\uBC95\uC0AC"
      dialogueContentSet:
      - dialogueIndex: 4
        storyLines:
        - '...... '
        - ".. \uD639\uC2DC \uC800\uD55C\uD14C \uBCFC\uC77C\uC774 \uC788\uC73C\uC2E0\uAC00\uC694?"
        choiceLines:
        - continueDialouge: 0
          nextDialogueID: 4
          choiceTexts:
          - "\uC544\uB2D9\uB2C8\uB2E4."
        - continueDialouge: 1
          nextDialogueID: 5
          choiceTexts:
          - "\uC800\uC640 \uD30C\uD2F0\uB97C \uB9FA\uC9C0 \uC54A\uC73C\uC2E4\uB798\uC694?"
      - dialogueIndex: 5
        storyLines:
        - "\uC800\uB3C4 \uD30C\uD2F0\uB97C \uAD6C\uD558\uACE0 \uC788\uAE30\uB294
          \uD588\uB294\uB370 \uAC11\uC791\uC2A4\uB7FD\uB124\uC694."
        choiceLines:
        - continueDialouge: 0
          nextDialogueID: 4
          choiceTexts:
          - "\uBD80\uB2F4\uC2A4\uB7EC\uC6B0\uC2DC\uB2E4\uBA74.. \uC54C\uACA0\uC2B5\uB2C8\uB2E4.."
        - continueDialouge: 1
          nextDialogueID: 6
          choiceTexts:
          - "\uBD80\uB2F4\uC2A4\uB7EC\uC6B0\uC2DC\uACA0\uC9C0\uB9CC \uC548\uB420\uAE4C\uC694..?"
      - dialogueIndex: 6
        storyLines:
        - "\uC81C \uACE0\uD5A5\uC758 \uACE8\uCE6B\uAC70\uB9AC\uB9CC \uD574\uACB0\uD574\uC8FC\uC2E0\uB2E4\uBA74
          \uD30C\uD2F0\uC5D0 \uCC38\uC5EC\uD560\uAC8C\uC694."
        - "\uB9C8\uC744 \uB0A8\uB3D9\uCABD\uC758 \uBFD4 \uC2AC\uB77C\uC784\uB4E4\uC774
          \uACE8\uCE6B\uAC70\uB9AC\uB77C\uACE0 \uD558\uB124\uC694."
        - "5\uB9C8\uB9AC \uC815\uB3C4\uB9CC \uD1F4\uCE58\uD574\uC8FC\uC2E4 \uC218
          \uC788\uB098\uC694?"
        choiceLines:
        - continueDialouge: 0
          nextDialogueID: 4
          choiceTexts:
          - "\uC8C4\uC1A1\uD569\uB2C8\uB2E4. \uC5C6\uB358\uC77C\uB85C \uD558\uC8E0."
        - continueDialouge: 0
          nextDialogueID: 4
          choiceTexts:
          - $Q1
          - "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uB530\uAC00 \uBD3D\uC8E0."
      - dialogueIndex: 7
        storyLines:
        - "\uBFD4 \uC2AC\uB77C\uC784\uC740 \uB9C8\uC744 \uB0A8\uB3D9\uCABD\uC5D0\uC11C
          \uC8FC\uB85C \uCD9C\uBAB0\uD55C\uB2E4\uACE0 \uD558\uB124\uC694."
        choiceLines: []
      - dialogueIndex: 8
        storyLines:
        - "\uC815\uB9D0\uB85C \uD1F4\uCE58\uD574\uC624\uC168\uB124\uC694.. \uC88B\uC2B5\uB2C8\uB2E4."
        - "\uC774\uC81C \uACE0\uD5A5\uC744 \uB5A0\uB098\uB3C4 \uB9C8\uC74C\uC774
          \uB193\uC77C\uAC70 \uAC19\uB124\uC694."
        - "\uC798 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!"
        - $A1
        - $X
        choiceLines: []
  dialogueName: Mage_NPC
